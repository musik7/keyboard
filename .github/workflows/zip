name: Extract Zip to Root

on:
  push:
    branches: [ "main" ]
  workflow_dispatch: # biar bisa pencet manual

jobs:
  extract:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Extract zip file ke root
        run: unzip -q -o kotlin-keyboard-app.zip
        # -q = quiet, -o = overwrite. ga pake -d = extract ke folder sekarang = root

      - name: Liat isi root setelah extract
        run: ls -la

      - name: Commit hasil extract ke repo
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add.
          git commit -m "Extract artifact.zip to root" || echo "Ga ada perubahan"
          git push
